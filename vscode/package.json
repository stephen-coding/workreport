{
  "name": "agent-coder",
  "displayName": "Agent Coder",
  "description": "Qoder-style agent coding assistant powered by the shared Python Agent Core",
  "version": "0.1.0",
  "publisher": "workreport",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:agentCoder.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCoder",
          "title": "Agent Coder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentCoder": [
        {
          "id": "agentCoder.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentCoder.openChat",
        "title": "Agent: 打开对话面板"
      },
      {
        "command": "agentCoder.generateDailyReport",
        "title": "Agent: 生成日报"
      },
      {
        "command": "agentCoder.restartCore",
        "title": "Agent: 重启 Agent Core"
      }
    ],
    "configuration": {
      "title": "Agent Coder",
      "properties": {
        "agentCoder.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径（留空则自动探测 python3/python，或使用 AGENT_PYTHON）"
        },
        "agentCoder.coreHome": {
          "type": "string",
          "default": "",
          "description": "Agent Core 目录（含 src/agent_core），留空则自动探测"
        },
        "agentCoder.provider": {
          "type": "string",
          "enum": ["ollama", "openai_compat"],
          "default": "ollama",
          "description": "LLM 提供商"
        },
        "agentCoder.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama 或 OpenAI 兼容端点"
        },
        "agentCoder.model": {
          "type": "string",
          "default": "qwen2.5:7b",
          "description": "模型名称"
        },
        "agentCoder.apiKey": {
          "type": "string",
          "default": "",
          "description": "云端 API Key（建议改用环境变量 OPENAI_API_KEY）"
        },
        "agentCoder.maxIterations": {
          "type": "number",
          "default": 15,
          "description": "单次任务的最大工具循环轮数"
        },
        "agentCoder.toolConcurrency": {
          "type": "number",
          "default": 4,
          "description": "工具并行度"
        },
        "agentCoder.subagentConcurrency": {
          "type": "number",
          "default": 3,
          "description": "子代理并行度"
        },
        "agentCoder.autoAcceptEdits": {
          "type": "boolean",
          "default": false,
          "description": "自动接受文件修改（跳过 diff 确认）"
        },
        "agentCoder.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP 服务配置（数组或 name 映射），项目内 .agent/mcp.json 优先",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "smoke": "node scripts/smoke-rpc.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
