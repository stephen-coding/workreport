<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.workreport</groupId>
    <artifactId>workreport-intellij-plugin</artifactId>
    <version>2.4.8</version>
    <packaging>jar</packaging>

    <name>Work Report AI Assistant</name>
    <description>IntelliJ IDEA plugin for generating AI-polished daily/weekly/quarterly/yearly reports from Git history</description>
    <!-- IntelliJ IDEA 插件：基于 Git 历史记录生成 AI 润色的日报/周报/季报/年报 -->

    <properties>
        <!-- JDK 21 -->
        <!-- JDK 21 编译版本 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- IntelliJ Platform SDK version (build number) -->
        <!-- IntelliJ 平台 SDK 版本（构建号） -->
        <intellij.version>261.25134.95</intellij.version>

        <!-- Dependency versions -->
        <!-- 依赖版本号 -->
        <okhttp.version>4.12.0</okhttp.version>

        <!-- Kotlin version must match the one bundled with the target platform -->
        <!-- Kotlin 版本需与目标平台内置的保持一致 -->
        <kotlin.version>2.3.20-RC2</kotlin.version>
    </properties>

    <!-- JetBrains IntelliJ Platform artifact repositories -->
    <!-- JetBrains IntelliJ 平台制品仓库 -->
    <repositories>
        <repository>
            <id>intellij-releases</id>
            <name>IntelliJ Platform Releases</name>
            <url>https://www.jetbrains.com/intellij-repository/releases</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>intellij-dependencies</id>
            <name>IntelliJ Platform Dependencies</name>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- ==================== IntelliJ Platform (provided by IDE at runtime) ==================== -->
        <!-- ==================== IntelliJ 平台 API（运行时由 IDE 提供） ==================== -->

        <!-- Core platform: Project, ApplicationManager, Service, ProgressManager, VirtualFile -->
        <!-- 核心平台：Project、ApplicationManager、Service、ProgressManager、VirtualFile -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Core UI: tool windows, settings, notifications, file chooser -->
        <!-- 核心 UI：工具窗口、设置页面、通知、文件选择器 -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core-ui</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- IDE Implementation: Configurable, PasswordSafe, CredentialStore, Messages -->
        <!-- IDE 实现：Configurable、PasswordSafe、CredentialStore、Messages -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide-impl</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- VCS Core: version control interfaces -->
        <!-- 版本控制核心接口 -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>vcs-core</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- VCS API -->
        <!-- 版本控制 API -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>vcs</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- DVCS interfaces (required by GitRepositoryManager) -->
        <!-- 分布式版本控制接口（GitRepositoryManager 依赖） -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>vcs-dvcs</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- DVCS impl: AbstractRepositoryManager -->
        <!-- 分布式版本控制实现：AbstractRepositoryManager -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>vcs-dvcs-impl</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- git4idea: GitLineHandler, GitRepositoryManager, GitCommand -->
        <!-- git4idea：Git 命令执行器、Git 仓库管理器、Git 命令定义 -->
        <dependency>
            <groupId>com.jetbrains.intellij.vcs</groupId>
            <artifactId>git</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Inline completion (editor ghost text) API -->
        <!-- 编辑器行内补全（Ghost text）API -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide-codeinsight-inline</artifactId>
            <version>${intellij.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JetBrains annotations (@NotNull, @Nullable) -->
        <!-- JetBrains 注解（@NotNull、@Nullable） -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson (provided by IntelliJ at runtime) -->
        <!-- Gson（由 IntelliJ 运行时提供） -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- ==================== Bundled dependencies (shipped with plugin) ==================== -->
        <!-- ==================== 打包依赖（随插件一起分发） ==================== -->

        <!-- Kotlin stdlib + coroutines are provided by the IDE at runtime -->
        <!-- Kotlin 标准库与协程由 IDE 运行时提供 -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.intellij.deps.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core-jvm</artifactId>
            <version>1.10.2-intellij-1</version>
            <scope>provided</scope>
        </dependency>

        <!-- OkHttp3 for HTTP calls to LLM APIs -->
        <!-- OkHttp3 用于调用 LLM API 的 HTTP 请求 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Java 21 compiler -->
            <!-- Java 21 编译器插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Kotlin compiler: the inline completion API is coroutine based -->
            <!-- Kotlin 编译器：行内补全 API 为协程风格，需用 Kotlin 实现 -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile-kotlin</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src/main/kotlin</sourceDir>
                        <sourceDir>${project.basedir}/src/main/java</sourceDir>
                    </sourceDirs>
                </configuration>
            </plugin>

            <!-- Package plugin JAR -->
            <!-- 打包插件 JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>

            <!-- Assemble plugin ZIP for distribution -->
            <!-- 组装插件 ZIP 用于分发安装 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>assembly/plugin-assembly.xml</descriptor>
                    </descriptors>
                    <appendAssemblyId>false</appendAssemblyId>
                    <finalName>workreport-ai-assistant-${project.version}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-plugin-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <!-- Include resources (plugin.xml) -->
        <!-- 包含资源文件（plugin.xml） -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
