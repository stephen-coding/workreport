<idea-plugin>
    <id>com.workreport.ai-assistant</id>
    <name>Agent Coding Assistant</name>
    <version>2.4.3</version>
    <vendor>WeeklyReport</vendor>
    <description><![CDATA[
        AI coding agent for IntelliJ-based IDEs. Chat with a language-agnostic agent core
        (Python) over a local RPC channel: streaming answers, tool execution, memory, skills.
        The classic work-report generator is being migrated into a built-in skill.
        <br/>
        AI 编码助手：通过本地 RPC 通道与语言无关的 Agent Core（Python）对话，支持流式输出、工具执行、
        记忆与 Skill。经典的工作报告生成器将迁移为内置 Skill。
    ]]></description>

    <!-- IntelliJ IDEA 2025.2.x - 2026.2.x (build 252.* - 262.*) -->
    <!-- 兼容 IntelliJ IDEA 2025.2.x 到 2026.2.x（构建号 252.* 到 262.*）；
         252 起才有 inline completion 扩展点 -->
    <idea-version since-build="252" until-build="262.*"/>

    <!-- Platform dependency -->
    <!-- 平台核心依赖 -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Git4Idea plugin dependency for git log collection -->
    <!-- Git4Idea 插件依赖，用于采集 Git 提交日志 -->
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window: agent chat panel in the bottom bar -->
        <!-- 工具窗口：底部 Agent 聊天面板 -->
        <toolWindow id="AgentCoder"
                    anchor="bottom"
                    factoryClass="com.workreport.agent.ui.AgentToolWindowFactory"/>

        <!-- Settings page: Settings -> Tools -> Agent Coding Assistant (model list / MCP / Embedding) -->
        <!-- 设置页面：Settings -> Tools -> Agent Coding Assistant（模型列表 / MCP / Embedding）；
             名称里带“模型设置”便于在设置树与搜索里被找到 -->
        <applicationConfigurable
                instance="com.workreport.plugin.settings.ReportSettingsConfigurable"
                id="com.workreport.settings"
                displayName="Agent Coding Assistant（模型设置）"
                parentId="tools"/>

        <!-- Editor inline completion (ghost text / fill-in-the-middle) -->
        <!-- 编辑器行内补全（Ghost text / FIM 补全） -->
        <inline.completion.provider
                id="com.workreport.agent.inline"
                implementation="com.workreport.agent.inline.AgentInlineCompletionProvider"
                order="first"/>

        <!-- Persistent state for plugin settings -->
        <!-- 插件设置的持久化状态服务 -->
        <applicationService
                serviceImplementation="com.workreport.plugin.settings.ReportSettingsState"/>
    </extensions>

    <!-- Tools menu: jump straight to the model settings page -->
    <!-- Tools 菜单：直接打开模型设置页（模型列表 / MCP / Embedding），Ctrl+Shift+A 也可搜到 -->
    <actions>
        <action id="AgentCoder.OpenSettings"
                class="com.workreport.agent.actions.OpenSettingsAction"
                text="模型设置…"
                description="打开 Agent Coding Assistant 设置页：模型列表、MCP 服务、Embedding 模型">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>

        <!-- Legacy report entry: sends "生成今天的日报" to the agent panel -->
        <!-- 旧报告入口：向 Agent 面板发送“生成今天的日报”指令 -->
        <action id="AgentCoder.GenerateReport"
                class="com.workreport.agent.actions.GenerateReportAction"
                text="生成今日日报"
                description="通过 Agent 的内置日报 Skill 生成今天的日报">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="AgentCoder.OpenSettings"/>
        </action>
    </actions>
</idea-plugin>
