<idea-plugin>
    <id>com.workreport.ai-assistant</id>
    <name>Agent Coding Assistant</name>
    <version>2.0.0</version>
    <vendor>WeeklyReport</vendor>
    <description><![CDATA[
        AI coding agent for IntelliJ-based IDEs. Chat with a language-agnostic agent core
        (Python) over a local RPC channel: streaming answers, tool execution, memory, skills.
        The classic work-report generator is being migrated into a built-in skill.
        <br/>
        AI 编码助手：通过本地 RPC 通道与语言无关的 Agent Core（Python）对话，支持流式输出、工具执行、
        记忆与 Skill。经典的工作报告生成器将迁移为内置 Skill。
    ]]></description>

    <!-- IntelliJ IDEA 2023.3.x - 2026.2.x (build 233.* - 262.*) -->
    <!-- 兼容 IntelliJ IDEA 2023.3.x 到 2026.2.x（构建号 233.* 到 262.*） -->
    <idea-version since-build="233" until-build="262.*"/>

    <!-- Platform dependency -->
    <!-- 平台核心依赖 -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Git4Idea plugin dependency for git log collection -->
    <!-- Git4Idea 插件依赖，用于采集 Git 提交日志 -->
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window: agent chat panel in the bottom bar -->
        <!-- 工具窗口：底部 Agent 聊天面板 -->
        <toolWindow id="AgentCoder"
                    anchor="bottom"
                    factoryClass="com.workreport.agent.ui.AgentToolWindowFactory"/>

        <!-- Settings page: Tools -> Work Report AI Assistant -->
        <!-- 设置页面：位于 Tools -> Work Report AI Assistant -->
        <applicationConfigurable
                instance="com.workreport.plugin.settings.ReportSettingsConfigurable"
                id="com.workreport.settings"
                displayName="Work Report AI Assistant"
                parentId="tools"/>

        <!-- Persistent state for plugin settings -->
        <!-- 插件设置的持久化状态服务 -->
        <applicationService
                serviceImplementation="com.workreport.plugin.settings.ReportSettingsState"/>
    </extensions>

    <!-- Legacy report entry: sends "生成今天的日报" to the agent panel -->
    <!-- 旧报告入口：向 Agent 面板发送“生成今天的日报”指令 -->
    <actions>
        <action id="AgentCoder.GenerateReport"
                class="com.workreport.agent.actions.GenerateReportAction"
                text="生成今日日报"
                description="通过 Agent 的内置日报 Skill 生成今天的日报">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
