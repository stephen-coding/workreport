<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>plugin</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Plugin JAR -->
    <!-- 插件主 JAR 包 -->
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>com.workreport.ai-assistant/lib</outputDirectory>
            <includes>
                <include>${project.artifactId}-${project.version}.jar</include>
            </includes>
        </fileSet>
    </fileSets>

    <!-- Bundled dependencies (OkHttp3 + transitive) -->
    <!-- 打包的运行时依赖（OkHttp3 及其传递依赖） -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>com.workreport.ai-assistant/lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <!-- Exclude IntelliJ platform JARs (provided scope, bundled by IDE) -->
            <!-- 排除 IntelliJ 平台 JAR（provided 作用域，由 IDE 运行时提供） -->
            <excludes>
                <exclude>com.jetbrains.intellij.platform:*</exclude>
                <exclude>com.jetbrains.intellij.vcs:*</exclude>
                <exclude>org.jetbrains:annotations</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
